        };

        // æ‰“å¼€æ¨¡åž‹è¯¦æƒ…å¼¹çª—
        function openModelDetail(modelId) {
            const detail = modelDetails[modelId];
            if (!detail) return;

            document.getElementById('modelDetailTitle').textContent = detail.title;

            // åœ¨å†…å®¹é¡¶éƒ¨æ’å…¥å‘å¸ƒæ—¶é—´
            let contentWithDate = detail.content;
            if (detail.releaseDate) {
                const dateBadge = `<div class="mb-4"><span class="inline-flex items-center px-3 py-1 rounded-full text-sm bg-gray-100 text-gray-600"><i class="far fa-calendar-alt mr-2"></i>å‘å¸ƒæ—¶é—´ï¼š${detail.releaseDate}</span></div>`;
                contentWithDate = dateBadge + contentWithDate;
            }

            document.getElementById('modelDetailContent').innerHTML = contentWithDate;
            document.getElementById('modelDetailModal').classList.remove('hidden');
            document.getElementById('modelDetailModal').classList.add('flex');
        }

        // å…³é—­æ¨¡åž‹è¯¦æƒ…å¼¹çª—
        function closeModelDetail() {
            document.getElementById('modelDetailModal').classList.add('hidden');
            document.getElementById('modelDetailModal').classList.remove('flex');
        }

        // ç­›é€‰æ ‡ç­¾ç‚¹å‡»äº‹ä»¶
        document.querySelectorAll('.filter-tag').forEach(tag => {
            tag.addEventListener('click', function() {
                const group = this.closest('.filter-tag-group');
                const filterType = group.dataset.filter;
                const selectedValue = this.dataset.value;

                // åŒä¸€ç»„å†…åªèƒ½é€‰ä¸€ä¸ªï¼ˆå•é€‰æ¨¡å¼ï¼‰
                group.querySelectorAll('.filter-tag').forEach(t => {
                    t.classList.remove('active', 'bg-primary', 'text-white', 'border-primary');
                    t.classList.add('border-gray-200', 'text-gray-600');
                });
                this.classList.add('active', 'bg-primary', 'text-white', 'border-primary');
                this.classList.remove('border-gray-200', 'text-gray-600');

                applyModelFilters();
            });
        });

        // æœç´¢è¾“å…¥äº‹ä»¶
        const searchInput = document.getElementById('modelSearchInput');
        if (searchInput) {
            searchInput.addEventListener('input', function() {
                applyModelFilters();
            });
        }

        // èŽ·å–å½“å‰æ¿€æ´»çš„ç­›é€‰æ¡ä»¶ï¼ˆæ ‡ç­¾æ¨¡å¼ï¼‰
        function getActiveFilters() {
            const filters = {
                'model-type': [],
                'modality': [],
                'context': [],
                'scenario': [],
                'vendor': []
            };

            document.querySelectorAll('.filter-tag-group').forEach(group => {
                const filterType = group.dataset.filter;
                const activeTag = group.querySelector('.filter-tag.active');
                if (activeTag) {
                    const value = activeTag.dataset.value;
                    if (value !== 'å…¨éƒ¨') {
                        filters[filterType].push(value);
                    }
                }
            });

            return filters;
        }

        // ä¸Šä¸‹æ–‡é•¿åº¦æ•°å€¼è§£æžï¼ˆç”¨äºŽåŒºé—´æ¯”è¾ƒï¼‰
        function parseContextValue(contextStr) {
            const match = contextStr.match(/(\d+)/);
            return match ? parseInt(match[1]) : 0;
        }

        // æ£€æŸ¥ä¸Šä¸‹æ–‡æ˜¯å¦åŒ¹é…åŒºé—´
        function matchesContextRange(contextValue, rangeValue) {
            const val = parseContextValue(contextValue);
            switch(rangeValue) {
                case 'â‰¤16K': return val <= 16;
                case '16K-64K': return val > 16 && val <= 64;
                case '64K-128K': return val > 64 && val <= 128;
                case '128K-1M': return val > 128 && val < 1024;
                case 'â‰¥1M': return val >= 1024;
                default: return contextValue === rangeValue;
            }
        }

        // åº”ç”¨ç­›é€‰å’Œæœç´¢
        function applyModelFilters() {
            const searchTerm = document.getElementById('modelSearchInput').value.toLowerCase().trim();
            const activeFilters = getActiveFilters();
            const modelCards = document.querySelectorAll('.model-card');
            const modelGroups = document.querySelectorAll('.model-group');
            let visibleCardCount = 0;

            modelCards.forEach(card => {
                const modelName = (card.dataset.modelName || '').toLowerCase();
                const vendor = (card.dataset.vendor || '').toLowerCase();
                const scenarios = (card.dataset.scenario || '').toLowerCase();
                const modelType = (card.dataset.modelType || '').toLowerCase();
                const modality = (card.dataset.modality || '').toLowerCase();
                const context = (card.dataset.context || '').toLowerCase();

                // æœç´¢åŒ¹é…
                let matchesSearch = true;
                if (searchTerm) {
                    matchesSearch = modelName.includes(searchTerm) ||
                                    vendor.includes(searchTerm) ||
                                    scenarios.includes(searchTerm);
                }

                // ç­›é€‰åŒ¹é…
                let matchesFilters = true;

                // æ¨¡åž‹ç±»åž‹ç­›é€‰ï¼ˆå¤šé€‰ï¼ŒORé€»è¾‘ï¼‰
                if (activeFilters['model-type'].length > 0) {
                    const types = modelType.split(',');
                    matchesFilters = matchesFilters && activeFilters['model-type'].some(t => types.includes(t.toLowerCase()));
                }

                // æ¨¡æ€ç­›é€‰ï¼ˆå¤šé€‰ï¼ŒORé€»è¾‘ï¼‰
                if (activeFilters['modality'].length > 0) {
                    matchesFilters = matchesFilters && activeFilters['modality'].some(m => modality === m.toLowerCase());
                }

                // ä¸Šä¸‹æ–‡é•¿åº¦ç­›é€‰ï¼ˆå¤šé€‰ï¼ŒORé€»è¾‘ - åŒºé—´åŒ¹é…ï¼‰
                if (activeFilters['context'].length > 0) {
                    matchesFilters = matchesFilters && activeFilters['context'].some(c => matchesContextRange(context, c));
                }

                // åº”ç”¨åœºæ™¯ç­›é€‰ï¼ˆå¤šé€‰ï¼ŒANDé€»è¾‘ - å¿…é¡»åŒæ—¶æ»¡è¶³æ‰€æœ‰é€‰ä¸­çš„åœºæ™¯ï¼‰
                if (activeFilters['scenario'].length > 0) {
                    matchesFilters = matchesFilters && activeFilters['scenario'].every(s => scenarios.includes(s.toLowerCase()));
                }

                // æ¨¡åž‹åŽ‚å•†ç­›é€‰ï¼ˆå¤šé€‰ï¼ŒORé€»è¾‘ï¼‰
                if (activeFilters['vendor'].length > 0) {
                    matchesFilters = matchesFilters && activeFilters['vendor'].some(v => vendor === v.toLowerCase());
                }

                if (matchesSearch && matchesFilters) {
                    card.style.display = '';
                    visibleCardCount++;
                } else {
                    card.style.display = 'none';
                }
            });

            // æ›´æ–°åŽ‚å•†åˆ†ç»„çš„æ˜¾ç¤º/éšè—
            modelGroups.forEach(group => {
                const visibleCards = group.querySelectorAll('.model-card:not([style*="display: none"])');
                if (visibleCards.length === 0) {
                    group.style.display = 'none';
                } else {
                    group.style.display = '';
                }
            });

            // æ˜¾ç¤º/éšè—æ— ç»“æžœæç¤º
            const noResults = document.getElementById('noModelResults');
            if (visibleCardCount === 0) {
                noResults.classList.remove('hidden');
            } else {
                noResults.classList.add('hidden');
            }
        }

        // é‡ç½®ç­›é€‰
        function resetModelFilters() {
            // æ¸…ç©ºæœç´¢æ¡†
            const searchInput = document.getElementById('modelSearchInput');
            if (searchInput) searchInput.value = '';

            // é‡ç½®æ‰€æœ‰ç­›é€‰æ ‡ç­¾
            document.querySelectorAll('#ai-models .filter-tag-group').forEach(group => {
                group.querySelectorAll('.filter-tag').forEach(t => {
                    if (t.dataset.value === 'å…¨éƒ¨') {
                        t.classList.add('active', 'bg-primary', 'text-white', 'border-primary');
                        t.classList.remove('border-gray-200', 'text-gray-600');
                    } else {
                        t.classList.remove('active', 'bg-primary', 'text-white', 'border-primary');
                        t.classList.add('border-gray-200', 'text-gray-600');
                    }
                });
            });

            // é‡æ–°åº”ç”¨ç­›é€‰ï¼ˆæ˜¾ç¤ºæ‰€æœ‰ï¼‰
            applyModelFilters();
        }

        // ===== æ•°æ®APIæœåŠ¡ç­›é€‰ =====
        function applyDataApiFilters() {
            const searchTerm = document.getElementById('dataApiSearchInput').value.toLowerCase().trim();
            const cards = document.querySelectorAll('#data-api .model-card');

            // èŽ·å–å½“å‰æ¿€æ´»çš„ç­›é€‰æ ‡ç­¾
            const filters = {};
            document.querySelectorAll('#data-api .filter-tag-group').forEach(group => {
                const filterType = group.dataset.filter;
                const activeTag = group.querySelector('.filter-tag.active');
                if (activeTag) {
                    filters[filterType] = activeTag.dataset.value;
                }
            });

            cards.forEach(card => {
                if (card.dataset.comingSoon === 'true') return;
                const title = (card.querySelector('h4')?.textContent || '').toLowerCase();
                const desc = (card.querySelector('p')?.textContent || '').toLowerCase();
                const tags = Array.from(card.querySelectorAll('span[class*="bg-primary"]')).map(s => s.textContent.toLowerCase()).join(' ');
                const text = title + ' ' + desc + ' ' + tags;

                // æœç´¢åŒ¹é…
                let matchesSearch = true;
                if (searchTerm) {
                    matchesSearch = text.includes(searchTerm);
                }

                // æ ‡ç­¾ç­›é€‰åŒ¹é…
                let matchesFilter = true;
                Object.keys(filters).forEach(filterType => {
                    const selectedValue = filters[filterType];
                    if (selectedValue !== 'å…¨éƒ¨') {
                        const cardValue = card.dataset[filterType.replace('-', '')] || '';
                        if (!cardValue.includes(selectedValue)) {
                            matchesFilter = false;
                        }
                    }
                });

                if (matchesSearch && matchesFilter) {
                    card.style.display = '';
                } else {
                    card.style.display = 'none';
                }
            });

            // æ›´æ–°æ•°æ®åˆ†ç±»ç»„çš„æ˜¾ç¤º/éšè—
            const dataGroups = document.querySelectorAll('#data-api .data-group');
            dataGroups.forEach(group => {
                const visibleCards = group.querySelectorAll('.model-card:not([style*="display: none"])');
                if (visibleCards.length === 0) {
                    group.style.display = 'none';
                } else {
                    group.style.display = '';
                }
            });
        }

        function resetDataApiFilters() {
            const searchInput = document.getElementById('dataApiSearchInput');
            if (searchInput) searchInput.value = '';
            document.querySelectorAll('#data-api .filter-tag-group').forEach(group => {
                group.querySelectorAll('.filter-tag').forEach(t => {
                    if (t.dataset.value === 'å…¨éƒ¨') {
                        t.classList.add('active', 'bg-primary', 'text-white', 'border-primary');
                        t.classList.remove('border-gray-200', 'text-gray-600');
                    } else {
                        t.classList.remove('active', 'bg-primary', 'text-white', 'border-primary');
                        t.classList.add('border-gray-200', 'text-gray-600');
                    }
                });
            });
            applyDataApiFilters();
        }

        // æ•°æ®APIç­›é€‰æ ‡ç­¾ç‚¹å‡»
        document.querySelectorAll('#data-api .filter-tag').forEach(tag => {
            tag.addEventListener('click', function() {
                const group = this.closest('.filter-tag-group');
                group.querySelectorAll('.filter-tag').forEach(t => {
                    t.classList.remove('active', 'bg-primary', 'text-white', 'border-primary');
                    t.classList.add('border-gray-200', 'text-gray-600');
                });
                this.classList.add('active', 'bg-primary', 'text-white', 'border-primary');
                this.classList.remove('border-gray-200', 'text-gray-600');
                // æ ‡ç­¾ç­›é€‰é€»è¾‘é¢„ç•™ï¼Œå¾…å¡ç‰‡æ·»åŠ dataå±žæ€§åŽå¯ç”¨
                applyDataApiFilters();
            });
        });

        // æ•°æ®APIæœç´¢
        const dataApiSearchInput = document.getElementById('dataApiSearchInput');
        if (dataApiSearchInput) {
            dataApiSearchInput.addEventListener('input', function() {
                applyDataApiFilters();
            });
        }

        // ===== äº‘èµ„æºæœåŠ¡ç­›é€‰ =====
        function applyCloudFilters() {
            const searchTerm = document.getElementById('cloudSearchInput').value.toLowerCase().trim();
            const cards = document.querySelectorAll('#cloud .model-card');

            // èŽ·å–å½“å‰æ¿€æ´»çš„ç­›é€‰æ ‡ç­¾
            const filters = {};
            document.querySelectorAll('#cloud .filter-tag-group').forEach(group => {
                const filterType = group.dataset.filter;
                const activeTag = group.querySelector('.filter-tag.active');
                if (activeTag) {
                    filters[filterType] = activeTag.dataset.value;
                }
            });

            cards.forEach(card => {
                if (card.dataset.comingSoon === 'true') return;
                const title = (card.querySelector('h4')?.textContent || '').toLowerCase();
                const desc = (card.querySelector('p')?.textContent || '').toLowerCase();
                const tags = Array.from(card.querySelectorAll('span[class*="bg-primary"]')).map(s => s.textContent.toLowerCase()).join(' ');
                const text = title + ' ' + desc + ' ' + tags;

                // æœç´¢åŒ¹é…
                let matchesSearch = true;
                if (searchTerm) {
                    matchesSearch = text.includes(searchTerm);
                }

                // æ ‡ç­¾ç­›é€‰åŒ¹é…
                let matchesFilter = true;
                Object.keys(filters).forEach(filterType => {
                    const selectedValue = filters[filterType];
                    if (selectedValue !== 'å…¨éƒ¨') {
                        const cardValue = card.dataset[filterType.replace('-', '')] || '';
                        if (!cardValue.includes(selectedValue)) {
                            matchesFilter = false;
                        }
                    }
                });

                if (matchesSearch && matchesFilter) {
                    card.style.display = '';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        function resetCloudFilters() {
            const searchInput = document.getElementById('cloudSearchInput');
            if (searchInput) searchInput.value = '';
            document.querySelectorAll('#cloud .filter-tag-group').forEach(group => {
                group.querySelectorAll('.filter-tag').forEach(t => {
                    if (t.dataset.value === 'å…¨éƒ¨') {
                        t.classList.add('active', 'bg-primary', 'text-white', 'border-primary');
                        t.classList.remove('border-gray-200', 'text-gray-600');
                    } else {
                        t.classList.remove('active', 'bg-primary', 'text-white', 'border-primary');
                        t.classList.add('border-gray-200', 'text-gray-600');
                    }
                });
            });
            applyCloudFilters();
        }

        // äº‘èµ„æºç­›é€‰æ ‡ç­¾ç‚¹å‡»
        document.querySelectorAll('#cloud .filter-tag').forEach(tag => {
            tag.addEventListener('click', function() {
                const group = this.closest('.filter-tag-group');
                group.querySelectorAll('.filter-tag').forEach(t => {
                    t.classList.remove('active', 'bg-primary', 'text-white', 'border-primary');
                    t.classList.add('border-gray-200', 'text-gray-600');
                });
                this.classList.add('active', 'bg-primary', 'text-white', 'border-primary');
                this.classList.remove('border-gray-200', 'text-gray-600');
                // æ ‡ç­¾ç­›é€‰é€»è¾‘é¢„ç•™ï¼Œå¾…å¡ç‰‡æ·»åŠ dataå±žæ€§åŽå¯ç”¨
                applyCloudFilters();
            });
        });

        // äº‘èµ„æºæœç´¢
        const cloudSearchInput = document.getElementById('cloudSearchInput');
        if (cloudSearchInput) {
            cloudSearchInput.addEventListener('input', function() {
                applyCloudFilters();
            });
        }

        // åˆ‡æ¢é€‰é¡¹å¡å‡½æ•°
        function switchTab(tabId) {
            // æ˜¾ç¤ºå¯¹åº”å†…å®¹åŒºï¼Œéšè—å…¶ä»–
            document.querySelectorAll('.tab-content').forEach(content => {
                content.classList.remove('active');
            });
            const targetContent = document.getElementById(tabId);
            if (targetContent) targetContent.classList.add('active');

            // æ›´æ–°å¯¼èˆªæ é«˜äº®ï¼šmaker-space å±žäºŽåˆ›å®¢ç©ºé—´æ¿å—
            const abilityNav = document.querySelector('a[href="services.html"]');
            const makerNav = document.querySelector('a[href="events.html"]');
            if (tabId === 'maker-space') {
                if (abilityNav) {
                    abilityNav.classList.remove('text-primary', 'border-b-2', 'border-primary');
                    abilityNav.classList.add('text-gray-600', 'hover:text-primary');
                }
                if (makerNav) {
                    makerNav.classList.remove('text-gray-600', 'hover:text-primary');
                    makerNav.classList.add('text-primary', 'border-b-2', 'border-primary');
                }
            } else {
                if (abilityNav) {
                    abilityNav.classList.remove('text-gray-600', 'hover:text-primary');
                    abilityNav.classList.add('text-primary', 'border-b-2', 'border-primary');
                }
                if (makerNav) {
                    makerNav.classList.remove('text-primary', 'border-b-2', 'border-primary');
                    makerNav.classList.add('text-gray-600', 'hover:text-primary');
                }
            }

            // æ›´æ–°URLä½†ä¸è§¦å‘åŽŸç”Ÿhashæ»šåŠ¨
            const url = new URL(window.location);
            url.hash = tabId;
            history.replaceState(null, '', url);

            // æ»šåŠ¨åˆ°é¡µé¢é¡¶éƒ¨
            window.scrollTo(0, 0);
        }

        // é¡µé¢åŠ è½½æ—¶æ£€æŸ¥é”šç‚¹å¹¶è‡ªåŠ¨åˆ‡æ¢
        // åœ¨æµè§ˆå™¨å¤„ç†hashæ»šåŠ¨å‰ï¼Œç«‹å³æˆªå–å¹¶æ¸…é™¤hash
        (function() {
            var rawHash = window.location.hash;
            if (rawHash) {
                window._pendingTab = rawHash.replace('#', '');
                // ç«‹å³æ¸…é™¤hashï¼Œé˜»æ­¢æµè§ˆå™¨åŽŸç”Ÿæ»šåŠ¨
                if (history.replaceState) {
                    history.replaceState(null, '', window.location.pathname + window.location.search);
                }
            }
        })();

        window.addEventListener('DOMContentLoaded', function() {
            if (window._pendingTab) {
                var validTabs = ['ai-models', 'data-api', 'cloud', 'maker-space'];
                if (validTabs.indexOf(window._pendingTab) !== -1) {
                    switchTab(window._pendingTab);
                }
                delete window._pendingTab;
            }
            // åŒé‡ä¿éšœï¼šå»¶è¿Ÿå†æ¬¡æ»šåˆ°é¡¶éƒ¨ï¼Œå‡»è´¥ä»»ä½•æ®‹ç•™çš„åŽŸç”Ÿæ»šåŠ¨
            window.scrollTo(0, 0);
            setTimeout(function() { window.scrollTo(0, 0); }, 50);
            setTimeout(function() { window.scrollTo(0, 0); }, 200);
        });
    </script>
